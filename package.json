{
  "name": "olympox",
  "version": "0.6.0-rc.1",
  "private": false,
  "type": "module",
  "description": "OLYMPOX - AI Influencer framework",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node bin/olympox.mjs setup",
    "studio": "node scripts/studio.mjs",
    "doctor": "node scripts/studio.mjs doctor",
    "validate": "node scripts/studio.mjs validate",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "docs:build": "node scripts/docs.mjs build",
    "docs:export": "node scripts/docs-export.mjs",
    "docs:check": "node scripts/docs.mjs check",
    "docs:dev": "node scripts/docs.mjs serve",
    "preverify": "npm run docs:build",
    "verify": "npm run test && npm run validate && npm run doctor && npm run docs:check"
  },
  "license": "MIT",
  "bin": {
    "olympox": "bin/olympox.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "skills/",
    "framework/",
    "templates/",
    "tests/",
    "vendor/",
    "docs/",
    "docs-site/README.md",
    "docs-site/config.json",
    "docs-site/locales/",
    "docs-site/src/",
    "influencers/README.md",
    "CONSTITUTION.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/linkiaai/olympox.git"
  },
  "homepage": "https://github.com/linkiaai/olympox#readme"
}
